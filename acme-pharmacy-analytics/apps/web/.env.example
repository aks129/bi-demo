# Database - Use Neon Postgres (https://neon.tech - free tier)
# For local dev, you can still use SQLite: file:./prisma/dev.db
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-secret-here"

# Claude API for chatbot
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Sigma Computing (optional)
SIGMA_CLIENT_ID="your-sigma-client-id"
SIGMA_CLIENT_SECRET="your-sigma-client-secret"

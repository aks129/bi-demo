generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String
  orgId     String?
  clientId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DimClient {
  id               String   @id @default(cuid())
  name             String
  segment          String
  region           String
  cmsContractNumber String?  // H-number (e.g., H1234)
  createdAt        DateTime @default(now())
}

model DimMember {
  id                String   @id @default(cuid())
  clientId          String
  memberId          String?  @unique // External MTM patient ID
  name              String
  firstName         String?
  lastName          String?
  age               Int
  dob               DateTime
  gender            String
  zipCode           String
  riskBand          String
  planId            String
  primaryPharmacyId String?  // NCPDP ID

  // 2025 CMS MTM Eligibility Fields
  drugCostsYTD      Float    @default(0)
  chronicDiseaseCount Int    @default(0)
  chronicDiseases   String?  // Comma-separated list of conditions
  activePartDMeds   Int      @default(0)
  mtmEligible       Boolean  @default(false)
  optOut            Boolean  @default(false)
  priorityScore     Int      @default(0) // 0-100, for work queue

  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())

  @@index([clientId])
  @@index([mtmEligible])
}

// MTM Activity/Claims Table - Tracks clinical interventions
model Claim {
  id              String   @id @default(cuid())
  claimId         String   @unique  // External Service ID
  clientId        String
  memberId        String   // References DimMember.id

  // Service Details
  serviceDate     DateTime
  serviceCode     Int      @default(99605) // CPT code
  opportunityType String   // CMR, TIP (Targeted Intervention Program)

  // Outcomes MTM Result Codes
  // 300 = DTP Identified (Success)
  // 301 = No DTP Identified (Success)
  // 379 = Unable to Reach
  // 380 = Patient Refused
  resultCode      Int?

  // AIM Model Fields (Cost Avoidance)
  severityLevel   Int      @default(1) // 1-7 severity scale
  aimDollarValue  Float    @default(0) // Projected cost avoidance

  // Workflow Status
  status          String   @default("Pending") // Pending, Approved, Review
  adherenceBarrier String? // SDoH/behavioral barriers (JSON string)

  // HEDIS IET Fields (SUD Treatment Tracking)
  indexDate       DateTime? // SUD episode start date
  initiationMet   Boolean  @default(false)
  engagementMet   Boolean  @default(false)
  ietWindowExpires DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())

  @@index([clientId])
  @@index([memberId])
  @@index([serviceDate])
  @@index([resultCode])
  @@index([status])
}

model FactAdherence {
  id          String   @id @default(cuid())
  clientId    String
  memberId    String
  drugClass   String
  pdc90       Float
  pdc180      Float
  mpr90       Float
  asOfDate    DateTime
  createdAt   DateTime @default(now())

  @@index([clientId])
  @@index([memberId])
  @@index([asOfDate])
}

model FactNotification {
  id          String    @id @default(cuid())
  clientId    String?
  ruleKey     String
  entityRef   String
  message     String
  recommendedAction String
  severity    String    // Critical, High, Medium, Low
  owner       String
  slaHours    Int
  status      String    // Active, open, triaged, Resolved
  createdAt   DateTime  @default(now())
  acknowledgedAt DateTime?
  resolvedAt  DateTime?

  @@index([status])
  @@index([severity])
}

// Reference: Core Chronic Diseases for 2025 CMS MTM
model ChronicDisease {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  category    String // CORE_10 for 2025 CMS mandatory conditions
}

// ============== ANALYTICS COMMUNITY ==============
model CommunityPost {
  id            String   @id @default(cuid())
  authorId      String
  authorName    String
  authorRole    String   @default("Member")
  title         String
  content       String
  category      String   // question, discussion, best-practice, announcement
  tags          String[]
  viewCount     Int      @default(0)
  isPinned      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  comments      CommunityComment[]
  votes         CommunityVote[]

  @@index([createdAt])
  @@index([category])
}

model CommunityComment {
  id        String   @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  authorName String
  content   String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
}

model CommunityVote {
  id        String   @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  value     Int      // 1 or -1
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

// ============== WIKI & DATA DICTIONARY ==============
model WikiPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  content     String
  category    String   // metric, process, clinical, technical
  parentId    String?
  authorId    String
  authorName  String
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  revisions   WikiRevision[]

  @@index([category])
  @@index([parentId])
}

model WikiRevision {
  id        String   @id @default(cuid())
  pageId    String
  page      WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  content   String
  authorId  String
  authorName String
  changeNote String?
  createdAt DateTime @default(now())

  @@index([pageId, createdAt])
}

model DataDictionaryEntry {
  id          String   @id @default(cuid())
  term        String   @unique
  definition  String
  category    String   // metric, dimension, clinical, business
  dataType    String?  // string, number, date, boolean
  source      String?  // table/field reference
  formula     String?  // calculation formula if derived
  example     String?
  relatedTerms String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

// ============== CASE STUDIES ==============
model CaseStudy {
  id          String   @id @default(cuid())
  clientId    String?
  title       String
  summary     String
  challenge   String
  solution    String
  outcomes    String   // JSON array: [{ metric, before, after, improvement }]
  industry    String   // medicare, medicaid, commercial, specialty
  tags        String[]
  featured    Boolean  @default(false)
  publishedAt DateTime?
  authorId    String
  authorName  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishedAt])
  @@index([industry])
  @@index([featured])
}

// ============== BENCHMARKING ==============
model BenchmarkMetric {
  id          String   @id @default(cuid())
  metricKey   String   // completion-rate, adherence-pdc, roi-multiple
  clientId    String
  period      String   // YYYY-MM or YYYY-Q1
  value       Float
  percentile  Int      // 0-100 vs national
  nationalAvg Float
  topDecile   Float
  createdAt   DateTime @default(now())

  @@unique([metricKey, clientId, period])
  @@index([metricKey, period])
}

model NationalBenchmark {
  id          String   @id @default(cuid())
  metricKey   String
  period      String
  average     Float
  median      Float
  topDecile   Float
  bottomDecile Float
  sampleSize  Int
  source      String   // CMS, internal, industry
  createdAt   DateTime @default(now())

  @@unique([metricKey, period])
}

// ============== CUSTOM REPORTS ==============
model CustomReport {
  id          String   @id @default(cuid())
  clientId    String?
  name        String
  description String?
  config      String   // JSON: { metrics[], filters{}, groupBy[], chartType }
  isPublic    Boolean  @default(false)
  authorId    String
  authorName  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  schedules   ReportSchedule[]

  @@index([authorId])
}

model ReportSchedule {
  id        String   @id @default(cuid())
  reportId  String
  report    CustomReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  frequency String   // daily, weekly, monthly
  recipients String[]
  lastRunAt DateTime?
  nextRunAt DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([nextRunAt, isActive])
}

// ============== ACTIVITY FEED ==============
model ActivityLog {
  id          String   @id @default(cuid())
  clientId    String?
  userId      String
  userName    String
  action      String   // created, updated, commented, completed, etc.
  entityType  String   // Claim, Member, Post, Report, etc.
  entityId    String
  entityTitle String?
  metadata    String?  // JSON for additional context
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
}
